ld be impossible.\u003c/span>\u003c/span>\n\u003cspan class=\"line\">\u003cspan style=\"color:#758575DD\">              //\u003c/span>\u003c/span>\n\u003cspan class=\"line\">\u003cspan style=\"color:#758575DD\">              // This helper will create a unique Identifier node\u003c/span>\u003c/span>\n\u003cspan class=\"line\">\u003cspan style=\"color:#758575DD\">              // specific to this string\u003c/span>\u003c/span>\n\u003cspan class=\"line\">\u003cspan style=\"color:#CB7676\">              const \u003c/span>\u003cspan style=\"color:#BD976A\">id\u003c/span>\u003cspan style=\"color:#666666\"> =\u003c/span>\u003cspan style=\"color:#BD976A\"> path\u003c/span>\u003cspan style=\"color:#666666\">.\u003c/span>\u003cspan style=\"color:#BD976A\">scope\u003c/span>\u003cspan style=\"color:#666666\">.\u003c/span>\u003cspan style=\"color:#80A665\">generateUidIdentifier\u003c/span>\u003cspan style=\"color:#666666\">(\u003c/span>\u003cspan style=\"color:#BD976A\">string\u003c/span>\u003cspan style=\"color:#666666\">);\u003c/span>\u003c/span>\n\u003cspan class=\"line\">\u003cspan style=\"color:#758575DD\">              // Here we replace each of our string paths with the Identifier\u003c/span>\u003c/span>\n\u003cspan class=\"line\">\u003cspan style=\"color:#758575DD\">              // returned above\u003c/span>\u003c/span>\n\u003cspan class=\"line\">\u003cspan style=\"color:#BD976A\">              paths\u003c/span>\u003cspan style=\"color:#666666\">.\u003c/span>\u003cspan style=\"color:#80A665\">forEach\u003c/span>\u003cspan style=\"color:#666666\">((\u003c/span>\u003cspan style=\"color:#BD976A\">stringPath\u003c/span>\u003cspan style=\"color:#666666\">: \u003c/span>\u003cspan style=\"color:#5DA994\">babel\u003c/span>\u003cspan style=\"color:#666666\">.\u003c/span>\u003cspan style=\"color:#5DA994\">NodePath\u003c/span>\u003cspan style=\"color:#666666\">&#x3C;\u003c/span>\u003cspan style=\"color:#5DA994\">t\u003c/span>\u003cspan style=\"color:#666666\">.\u003c/span>\u003cs