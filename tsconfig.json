{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"allowImportingTsExtensions": true,
		"isolatedModules": true,

		"jsx": "preserve",
		"jsxImportSource": "solid-js",

		"types": ["bun", "vite/client"],
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,

		"paths": {
			"~/*": ["./src/*"]
		}
	}
}