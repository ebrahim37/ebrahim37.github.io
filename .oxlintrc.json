{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "jsx-a11y"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"env": {
		"browser": true,
		"node": true
	},
	"ignorePatterns": ["docs/**"],
	"rules": {
		"eqeqeq": "error",
		"import/no-cycle": "error",
		"no-debugger": "error",
		"no-var": "error",
		"prefer-const": "error"
	}
}